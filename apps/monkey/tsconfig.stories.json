{
  "extends": "@115master/tsconfig/vue-app.json",
  "compilerOptions": {
    "composite": false,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.stories.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "motion-v": ["./src/types/motion-v"],
      "react": ["./.storybook/react-stub.d.ts"]
    },
    "declaration": false,
    "declarationMap": false
  },
