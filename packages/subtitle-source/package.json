{
  "name": "@115master/subtitle-source",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "description": "Subtitle source clients for 115Master",
  "author": "cbingb666",
  "license": "MIT",
  "homepage": "https://github.com/cbingb666/115master",
  "repository": {
    "type": "git",
    "url": "https://github.com/cbingb666/115master.git",
    "directory": "/packages/subtitle-source"
  },
  "bugs": {
    "url": "https://github.com/cbingb666/115master/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist node_modules/.tmp/tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@115master/shared": "workspace:*",
    "blueimp-md5": "^2.19.0"
  },
  "devDependencies": {
    "@115master/eslint-config": "workspace:*",
    "@115master/tsconfig": "workspace:*",
    "@types/blueimp-md5": "^2.18.2",
    "@vitest/coverage-v8": "^3.0.5",
    "happy-dom": "^20.10.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
