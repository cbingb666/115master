{
  "name": "@115master/shared",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "description": "Shared utilities for 115Master",
  "author": "cbingb666",
  "license": "MIT",
  "homepage": "https://github.com/cbingb666/115master",
  "repository": {
    "type": "git",
    "url": "https://github.com/cbingb666/115master.git",
    "directory": "/packages/shared"
  },
  "bugs": {
    "url": "https://github.com/cbingb666/115master/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./115polyfills": {
      "types": "./dist/115polyfills/index.d.ts",
      "default": "./dist/115polyfills/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@115master/eslint-config": "workspace:*",
    "@115master/tsconfig": "workspace:*",
    "@types/lodash": "^4.17.15",
    "typescript": "^5.7.3",
    "vite-plugin-monkey": "^5.0.5"
  }
}
