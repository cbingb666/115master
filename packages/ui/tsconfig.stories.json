{
  "extends": "@115master/tsconfig/vue-app.json",
  "compilerOptions": {
    "composite": false,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.stories.tsbuildinfo",
    "baseUrl": ".",
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "package.json",
    "src/**/*.d.ts",
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx",
    ".storybook/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
